---
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site;
const canonical = new URL('/404', site ?? 'https://cunconvert.example.com/').href;
---

<BaseLayout
  title="页面不存在 - CunConvert"
  description="你访问的页面不存在，返回 CunConvert 首页继续使用图片工具。"
  canonical={canonical}
>
  <div class="container">
    <div class="notfound">
      <h1>404</h1>
      <p>你访问的页面不存在或已被移动。</p>
      <p style="margin-top:20px">
        <a class="btn-primary" style="display:inline-block;text-decoration:none;color:#fff" href="/">返回首页</a>
      </p>
    </div>
  </div>
</BaseLayout>
