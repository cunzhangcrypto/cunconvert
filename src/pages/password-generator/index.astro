---
import ToolPage from '../../components/ToolPage.astro';
---
<ToolPage slug="password-generator" shell="workspace">
  <div class="sec-result">
    <span class="sec-output placeholder" data-pw-output>正在生成…</span>
    <button type="button" class="btn-small" data-pw-copy hidden>复制</button>
  </div>

  <div class="sec-strength" data-pw-strength hidden>
    <div class="sec-strength-bar"><i></i></div>
    <span class="sec-strength-label" data-pw-strength-label>—</span>
  </div>

  <div class="sec-fields">
    <div class="param-block sec-span">
      <div class="param-label">密码长度</div>
      <div class="seg" data-param="pw-length">
        <button type="button" data-value="8">8</button>
        <button type="button" data-value="12">12</button>
        <button type="button" data-value="16">16</button>
        <button type="button" data-value="20" class="active">20</button>
        <button type="button" data-value="24">24</button>
        <button type="button" data-value="32">32</button>
        <button type="button" data-value="custom">自定义</button>
      </div>
      <div class="input-row sec-custom" data-pw-custom hidden>
        <input
          type="number"
          class="input-num"
          data-param="pw-custom"
          min="8"
          max="128"
          value="20"
          aria-label="自定义密码长度" />
        <span class="param-note sec-inline-note">8 – 128 位</span>
      </div>
    </div>

    <div class="param-block sec-span">
      <div class="param-label">字符类型</div>
      <div class="sec-checks">
        <label class="check"><input type="checkbox" data-param="pw-upper" checked /> 大写字母 A-Z</label>
        <label class="check"><input type="checkbox" data-param="pw-lower" checked /> 小写字母 a-z</label>
        <label class="check"><input type="checkbox" data-param="pw-digit" checked /> 数字 0-9</label>
        <label class="check"><input type="checkbox" data-param="pw-symbol" checked /> 特殊符号</label>
        <label class="check sec-check-wide">
          <input type="checkbox" data-param="pw-noambiguous" /> 排除容易混淆的字符（0 O o 1 I l）
        </label>
      </div>
    </div>
  </div>

  <div class="actions">
    <button type="button" class="btn-primary" data-pw-generate>重新生成</button>
  </div>

  <div data-notice></div>
  <p class="sec-tip">🔒 所有数据均在浏览器本地处理，不会上传到服务器。生成的密码不会被 CunConvert 收集或保存。</p>
</ToolPage>
