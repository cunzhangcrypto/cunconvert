---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConvertShell from '../components/ConvertShell.astro';
import { getTool, relatedTools, toolCategories } from '../data/tools';
import { getGuide } from '../data/guides';
import { canonicalUrl } from '../lib/utils/site';

interface Props {
  slug: string;
  actionLabel?: string;
  icon?: string;
  resultTitle?: string;
  /** convert = 标准「上传→转换→下载」外壳；workspace = 自定义工作区（无上传区） */
  shell?: 'convert' | 'workspace';
}

const { slug, actionLabel, icon, resultTitle, shell = 'convert' } = Astro.props;
const tool = getTool(slug);
const guide = getGuide(slug);
const related = tool ? relatedTools(tool) : [];
const canonical = canonicalUrl(`/${slug}/`);

if (!tool) throw new Error(`未找到工具：${slug}`);

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  url: canonical,
  description: tool.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: '需要现代浏览器',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  inLanguage: 'zh-CN',
};

const faqLd = guide
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: guide.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// 面包屑：首页 > 分类 > 当前工具
const catLabel = toolCategories.find((c) => c.key === tool.category)?.label ?? '';
const breadcrumbLd = canonical
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: canonicalUrl('/') },
        { '@type': 'ListItem', position: 2, name: catLabel, item: canonicalUrl('/') },
        { '@type': 'ListItem', position: 3, name: tool.name, item: canonical },
      ],
    }
  : null;

const jsonLd = [
  JSON.stringify(webAppLd),
  faqLd ? JSON.stringify(faqLd) : '',
  breadcrumbLd ? JSON.stringify(breadcrumbLd) : '',
].filter(Boolean);
---

<BaseLayout title={tool.title} description={tool.description} canonical={canonical} jsonLd={jsonLd}>
  <div class="container page">
    <div class="tool-header">
      <span class="tool-local-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        文件在浏览器本地处理，不会上传
      </span>
      <h1>{tool.h1}</h1>
      <p class="intro">{tool.intro}</p>
    </div>

    {
      shell === 'convert' ? (
        <ConvertShell slug={slug} accept={tool.accept} actionLabel={actionLabel} icon={icon} resultTitle={resultTitle}>
          <div class="params-panel"><slot /></div>
        </ConvertShell>
      ) : (
        <div class="tool-workspace" data-tool={slug}><slot /></div>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <h2>相关工具</h2>
          <div class="related-grid">
            {related.map((t) => (
              <a href={`/${t.slug}/`}>
                {t.name}
                <br />
                <small style="color:var(--text-faint);font-weight:400">{t.short}</small>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      guide && (
        <article class="guide">
          <div class="guide-intro">{guide.lead}</div>
          {guide.sections.map((s) => (
            <section>
              <h2>{s.h2}</h2>
              {s.paragraphs.map((p) => <p set:html={p} />)}
              {
                s.list && s.list.length > 0 && (
                  <ul>
                    {s.list.map((li) => <li set:html={li} />)}
                  </ul>
                )
              }
            </section>
          ))}
        </article>
      )
    }

    {
      guide && guide.faq.length > 0 && (
        <section class="faq-section">
          <h2>常见问题</h2>
          {guide.faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import { mountTool } from '../scripts/tool-loader';
  const root = document.querySelector<HTMLElement>('[data-tool]');
  if (root && root.dataset.tool) {
    void mountTool(root, root.dataset.tool);
  }
</script>
